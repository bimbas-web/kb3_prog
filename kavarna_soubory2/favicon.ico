/* ===== Základ ===== */
* {
    box-sizing: border-box;
}

body {
    background-color: #201813;
    color: #f5ead8;
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
}

a {
    color: #d6ad68;
    transition: color 0.2s;
}

a:hover {
    color: #f5ead8;
}

/* ===== Hlavička s logem ===== */
header {
    background-color: #38271d;
    color: #d6ad68;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    border-bottom: 3px solid #6e5032;
}

header img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
}

.hlavicka-text {
    text-align: left;
}

header h1 {
    font-size: 36px;
    margin: 0;
}

header h1 a {
    color: #d6ad68;
    text-decoration: none;
}

header h1 a:hover {
    color: #f5ead8;
}

header p {
    margin: 5px 0 0 0;
    font-style: italic;
}

/* ===== Navigace ===== */
nav {
    background-color: #120e0b;
    text-align: center;
    padding: 10px;
}

nav a {
    color: #d6ad68;
    text-decoration: none;
    margin: 5px 10px;
    padding: 8px 14px;
    font-weight: bold;
    display: inline-block;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
}

nav a:hover {
    color: #f5ead8;
    border-bottom: 2px solid #d6ad68;
    background-color: #38271d;
}

nav a.aktivni {
    border-bottom: 2px solid #d6ad68;
}

/* ===== Obsah ===== */
main {
    max-width: 900px;
    margin: 0 auto;
    padding: 10px;
}

section {
    padding: 25px;
    margin: 20px 0;
}

h2 {
    color: #d6ad68;
    text-align: center;
    font-size: 28px;
}

h3 {
    color: #d6ad68;
}

.uvod {
    text-align: center;
    font-size: 18px;
}

img.foto {
    width: 100%;
    max-width: 700px;
    height: auto;
    display: block;
    margin: 20px auto;
    border-radius: 8px;
    transition: transform 0.3s, box-shadow 0.3s;
}

img.foto:hover {
    transform: scale(1.02);
    box-shadow: 0 0 20px rgba(214, 173, 104, 0.4);
}

hr {
    border: 1px solid #6e5032;
}

/* ===== Karty (úvodní stránka) ===== */
.karty {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
}

.karta {
    background-color: #38271d;
    border: 1px solid #6e5032;
    border-radius: 8px;
    padding: 20px;
    flex: 1 1 220px;
    text-align: center;
    transition: transform 0.2s, border-color 0.2s;
}

.karta:hover {
    transform: translateY(-5px);
    border-color: #d6ad68;
}

.karta h3 {
    margin-top: 0;
}

/* ===== Tlačítko ===== */
.tlacitko {
    display: inline-block;
    background-color: #d6ad68;
    color: #201813;
    text-decoration: none;
    font-weight: bold;
    padding: 12px 28px;
    border-radius: 25px;
    transition: all 0.2s;
}

.tlacitko:hover {
    background-color: #f5ead8;
    color: #201813;
    transform: scale(1.05);
}

.stred {
    text-align: center;
}

/* ===== Nabídka ===== */
.menu {
    list-style: none;
    padding: 0;
    margin: 0;
}

.menu li {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 12px 10px;
    border-bottom: 1px dotted #6e5032;
    transition: background-color 0.2s;
}

.menu li:hover {
    background-color: #38271d;
}

.menu .popis {
    display: block;
    font-size: 14px;
    color: #c9b896;
}

.menu .cena {
    color: #d6ad68;
    font-weight: bold;
    white-space: nowrap;
}

/* ===== Kontakt ===== */
.kontakt-box {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
}

.kontakt-box > div {
    flex: 1 1 280px;
}

.hodiny {
    list-style: none;
    padding: 0;
}

.hodiny li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dotted #6e5032;
    padding: 6px 0;
}

.mapa {
    width: 100%;
    height: 400px;
    border: 3px solid #6e5032;
    border-radius: 8px;
    margin-top: 10px;
}

/* ===== Patička ===== */
footer {
    background-color: #120e0b;
    color: #d6ad68;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
    border-top: 3px solid #6e5032;
}

footer p {
    margin: 4px 0;
}

/* ===== Mobil ===== */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        text-align: center;
        gap: 10px;
    }

    .hlavicka-text {
        text-align: center;
    }

    header h1 {
        font-size: 28px;
    }

    header img {
        width: 90px;
        height: 90px;
    }

    nav a {
        margin: 3px;
        padding: 8px 10px;
    }

    section {
        padding: 10px;
    }

    .mapa {
        height: 300px;
    }
}
